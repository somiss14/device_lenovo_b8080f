# Lenovo Yoga Tablet 10 HD+ (B8080-F) - minimal Qualcomm startup for LineageOS 14.1.
# Adapted from the tablet's stock init.qcom.rc / init.target.rc. Only what is needed
# to reach a working UI, Wi-Fi and Bluetooth; more of the stock daemons can be added back later.

import init.qcom.usb.rc

on early-init
    # KitKat Adreno libs dlopen("egl/libGLESv2_adreno.so") with a relative path; Android 7 no longer searches for it.
    symlink /system/vendor/lib/egl /egl
    # rootfs files from the ramdisk are 0644 and rootfs goes read-only later, so fix the exec bit now
    chmod 0755 /insmod_legacy
    # Bring-up: adb over USB as early as possible (before /data or /system are mounted)
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE7
    write /sys/class/android_usb/android0/iManufacturer Lenovo
    write /sys/class/android_usb/android0/iProduct B8080-LOS
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    mkdir /firmware 0771 system system
    mkdir /persist 0771 system system
    mount debugfs /sys/kernel/debug /sys/kernel/debug mode=755

on fs
    mount_all /fstab.qcom
    write /proc/sys/vm/page-cluster 0
    start bootlog

on post-fs-data
    mkdir /data/tombstones 0771 system system
    mkdir /data/misc/audio 0770 audio audio
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
    mkdir /data/misc/sensors 0775 system system
    mkdir /data/hostapd 0770 system wifi
    chown system system /persist
    chmod 0771 /persist
    setprop vold.post_fs_data_done 1

on early-boot
    start ssr_relax
    start sensors_boot

on boot
    # Bluetooth (Qualcomm SMD transport)
    chown bluetooth bluetooth /sys/module/bluetooth_power/parameters/power
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /proc/bluetooth/sleep/proto
    chown bluetooth bluetooth /sys/module/hci_smd/parameters/hcismd_set
    chmod 0660 /sys/module/bluetooth_power/parameters/power
    chmod 0660 /sys/module/hci_smd/parameters/hcismd_set
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /proc/bluetooth/sleep/proto
    chown bluetooth bluetooth /dev/ttyHS0
    chmod 0660 /dev/ttyHS0
    mkdir /dev/socket/qmux_bluetooth 0770 bluetooth bluetooth
    chmod 2770 /dev/socket/qmux_bluetooth
    # Wi-Fi
    setprop wifi.interface wlan0
    # Display backlight
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    chmod 0644 /proc/cmdline

# Wi-Fi: wcnss_service pushes the NV/calibration data to the Pronto subsystem.
service wcnss-service /system/bin/wcnss_service
    class late_start
    user system
    group system wifi
    oneshot

# Bluetooth: the Qualcomm libbt-vendor raises these properties to start the helpers.
service start_hci_filter /system/bin/wcnss_filter
    class late_start
    user bluetooth
    group bluetooth
    disabled

service config_bluetooth /system/bin/sh /system/etc/init.qcom.bt.sh "onboot"
    class core
    user root
    oneshot

service hciattach /system/bin/sh /system/etc/init.qcom.bt.sh
    class late_start
    user bluetooth
    group bluetooth net_bt_admin
    disabled
    oneshot

on property:bluetooth.start_hci=true
    start start_hci_filter

on property:bluetooth.start_hci=false
    stop start_hci_filter

on property:bluetooth.hciattach=true
    start hciattach

on property:bluetooth.hciattach=false
    setprop bluetooth.status off

on property:init.svc.wpa_supplicant=stopped
    stop dhcpcd

# Bring-up diagnostics (see bootlog.sh): logs land in /cache/bootlog
service bootlog /system/bin/sh /bootlog.sh
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:su:s0

service ssr_relax /system/bin/sh /ssr_relax.sh
    class main
    user root
    disabled
    oneshot
    seclabel u:r:su:s0

# Kernel 3.4 has no finit_module, which Android 7.1 uses to load WIFI_DRIVER_MODULE_PATH; init's
# insmod uses init_module, so load the Pronto WLAN driver from init instead.
service wlan_loader /insmod_legacy /system/lib/modules/pronto/pronto_wlan.ko
    class main
    user root
    disabled
    oneshot
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start wlan_loader
    setprop wlan.driver.status ok

# Sensors: boot the ADSP, then start the Qualcomm sensor daemon (see sensors_start.sh).
service sensors_boot /system/bin/sh /sensors_start.sh
    class main
    user root
    disabled
    oneshot
    seclabel u:r:su:s0

service sensors /system/bin/sensors.qcom
    class late_start
    user root
    group root
    disabled
    seclabel u:r:su:s0

service p2p_supplicant /system/bin/wpa_supplicant \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf -N \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -puse_p2p_group_interface=1 \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# Stock HAL1 camera daemon (mm-camera ISP). HAL (cameraserver) and daemon talk
# over /data/cam_socketN unix sockets whose group is the daemon's fsgid, so it
NB: the daemon primary group must be camera (AID_CAMERA) -- this
# build cameraserver runs gid=camera and the /data/cam_socketN group follows
# the daemon fsgid. NB: this init (backported parser) enforces
# IsValidName: alnum/_/- and <=16 chars -- the stock 17-char name
# mm-qcamera-daemon is rejected outright, hence the short service name here.
service mm-qcamera /system/bin/mm-qcamera-daemon
    class main
    user root
    group camera


# No userspace wifi HAL on this port: replicate wifi.msm8226.so's power-on
# (open /dev/wcnss_wlan boots the WCNSS firmware; prima never sets IFF_UP
# itself, so scans silently return nothing while the UI says Wi-Fi is on).
service wifipower /system/bin/sh /system/etc/wifi/wifipower.sh
    class main
    user root
    group root wifi system
    oneshot
    disabled

on property:init.svc.wpa_supplicant=running
    start wifipower

on property:init.svc.p2p_supplicant=running
    start wifipower



# Vidc on this 3.4 kernel registers V4L2 /dev/videoNN, but the stock KK
# libOmxVdec (see the device.mk note) opens the legacy named nodes from the
# 4.4.2 days. symlink(2) does not need the target to exist yet, so running
# this in the early boot phase is safe. Indices follow the fixed vidc probe order on
# this board: video32=dec, video33=enc, video34=dec-secure, video35=enc-secure.
on boot
    mkdir /dev/video 0755 root root
    symlink /dev/video32 /dev/video/venus_dec
    symlink /dev/video34 /dev/video/venus_dec_secure
    symlink /dev/video33 /dev/video/venus_enc
    symlink /dev/video35 /dev/video/venus_enc_secure
